{
  "name": "kafstyler",
  "version": "0.6.0",
  "description": "AIエージェントが開発・調査・制作・運用で目標を定め、成果を検証して届け、文書や手法を自律的に改善する。",
  "repository": "https://github.com/KAFKA2306/kafstyler",
  "skills": "./skills/",
  "interface": {
    "displayName": "Kafstyler",
    "shortDescription": "成果を検証し、次の担当に引き継ぐAIエージェント用プラグイン"
  },
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/.agents/quality.sh\" session codex",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/.agents/quality.sh\" start codex",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}
