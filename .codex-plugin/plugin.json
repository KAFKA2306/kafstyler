{
  "name": "kafstyler",
  "version": "0.9.0",
  "description": "常時稼働エージェントを中核に、開発・調査・制作・運用を継続し、実成果を検証して再開・改善する。",
  "repository": "https://github.com/KAFKA2306/kafstyler",
  "skills": "./skills/",
  "interface": {
    "displayName": "Kafstyler",
    "shortDescription": "常時稼働と実成果の検証を担うAIエージェント用プラグイン"
  },
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/.agents/quality.sh\" session codex",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/.agents/quality.sh\" start codex",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}
