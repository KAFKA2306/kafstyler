{
  "name": "kafstyler",
  "version": "0.5.2",
  "description": "目標を定め、成果物を評価して直し、文書と作業手順を改善する。",
  "repository": "https://github.com/KAFKA2306/kafstyler",
  "skills": "./skills/",
  "interface": {
    "displayName": "Kafstyler",
    "shortDescription": "目標設定、成果物の評価、修正と再評価を回す"
  },
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/hooks/quality.sh\" session codex",
              "timeout": 5
            }
          ]
        }
      ],
      "SubagentStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/hooks/quality.sh\" subagent codex",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/hooks/quality.sh\" start codex",
              "timeout": 5
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/hooks/quality.sh\" review codex",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}
