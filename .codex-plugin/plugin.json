{
  "name": "kafstyler",
  "version": "0.5.31",
  "description": "開発・調査・制作・運用でAIエージェントが目標と合格条件を定め、成果物を検証して届け、結果から作業手順を改善する。",
  "repository": "https://github.com/KAFKA2306/kafstyler",
  "skills": "./skills/",
  "interface": {
    "displayName": "Kafstyler",
    "shortDescription": "AIエージェントが目標と合格条件を定め、成果物を検証して届ける"
  },
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/hooks/quality.sh\" session codex",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/hooks/quality.sh\" start codex",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}
