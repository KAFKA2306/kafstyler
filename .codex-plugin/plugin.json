{
  "name": "kafstyler",
  "version": "0.9.1",
  "description": "AIの仕事を回答で終わらせず、完成条件の設定・実装・公開確認・引き継ぎまで進める7スキル。定期処理や中断後の再開にも対応。",
  "repository": "https://github.com/KAFKA2306/kafstyler",
  "skills": "./skills/",
  "interface": {
    "displayName": "Kafstyler",
    "shortDescription": "AIの仕事を成果・検証・引き継ぎまで進める7スキル"
  },
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/.agents/quality.sh\" session codex",
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$PLUGIN_ROOT/.agents/quality.sh\" start codex",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}
