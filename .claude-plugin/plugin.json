{
  "name": "kafstyler",
  "version": "0.9.1",
  "description": "AIの仕事を回答で終わらせず、完成条件の設定・実装・公開確認・引き継ぎまで進める7スキル。定期処理や中断後の再開にも対応。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/.agents/quality.sh\" session",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/.agents/quality.sh\" start",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
