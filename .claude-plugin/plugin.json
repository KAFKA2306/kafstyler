{
  "name": "kafstyler",
  "version": "0.8.0",
  "description": "常時稼働エージェントを中核に、開発・調査・制作・運用を継続し、実成果を検証して再開・改善する。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/.agents/quality.sh\" session",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/.agents/quality.sh\" start",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
