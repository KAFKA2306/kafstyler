{
  "name": "kafstyler",
  "version": "0.5.2",
  "description": "AIエージェントが開発・調査・制作・運用で目標を定め、成果を検証して届け、文書や手法を自律的に改善する。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/quality.sh\" session",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/quality.sh\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/quality.sh\" subagent",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/quality.sh\" review",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
