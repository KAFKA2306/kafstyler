{
  "name": "kafstyler",
  "version": "0.5.25",
  "description": "開発・調査・制作・運用でAIエージェントが目標と合格条件を定め、成果物を検証して届け、結果から作業手順を改善する。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/quality.sh\" session",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/quality.sh\" start",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
